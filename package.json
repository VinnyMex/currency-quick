{
  "name": "currency-quick",
  "version": "1.0.0",
  "description": "Conversor de moedas rápido - extensão Chrome e PWA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.js",
    "extension:build": "npm run build && node scripts/build-extension.js",
    "setup": "npm install && npm run icons",
    "build:vercel": "vite build && node scripts/post-build.cjs"
  },
  "devDependencies": {
    "archiver": "^6.0.0",
    "puppeteer": "^25.10.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.19.0",
    "vitest": "^1.0.0"
  }
}