{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "framework": null,
  "routes": [
    {
      "src": "/currency-quick.zip",
      "dest": "/currency-quick.zip",
      "headers": {
        "Content-Type": "application/zip",
        "Content-Disposition": "attachment; filename=\"currency-quick.zip\""
      }
    },
    { "src": "/app", "dest": "/app/index.html" },
    { "src": "/app/(.*)", "dest": "/app/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
